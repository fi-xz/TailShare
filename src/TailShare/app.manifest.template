<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="TailShare.app" />

  <!-- Ties the exe to the sparse package so it runs with package identity.
       {{...}} are filled at build time from the TailSharePublisher / TailSharePackageName MSBuild
       properties (scripts\build.ps1 passes them from config.local.psd1). -->
  <msix xmlns="urn:schemas-microsoft-com:msix.v1"
        publisher="{{Publisher}}"
        packageName="{{PackageName}}"
        applicationId="TailShare" />

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>

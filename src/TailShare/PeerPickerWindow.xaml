<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TailShare.PeerPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TailShare"
    Title="Tailscale">

    <Grid x:Name="Root" Padding="20,12,20,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Send to device" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="SummaryText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <ListView x:Name="PeerList" Grid.Row="1" Margin="-16,0"
                  SelectionMode="Single"
                  SelectionChanged="PeerList_SelectionChanged"
                  DoubleTapped="PeerList_DoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:Peer">
                    <StackPanel Padding="0,6" Opacity="{x:Bind ItemOpacity}">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Detail}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="SendingPanel" Grid.Row="1" Spacing="12" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressRing IsActive="True" Width="40" Height="40" />
            <TextBlock x:Name="SendingText" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="SendButton" Content="Send" MinWidth="96" IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" Click="SendButton_Click" />
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="96" Click="CancelButton_Click">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" />
                </Button.KeyboardAccelerators>
            </Button>
        </StackPanel>
    </Grid>
</Window>
